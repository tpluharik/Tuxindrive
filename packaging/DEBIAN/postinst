#!/bin/sh
set -e

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi

# A running Gtk.Application keeps its imported Python modules in memory across
# a dpkg upgrade. The next Nautilus action would otherwise be forwarded to the
# old process while the new extension reads the new state schema. Stop only the
# exact TuxInDrive application command on upgrades; the next desktop/Nautilus
# action starts the newly installed version, whose stale-mount recovery safely
# detaches any FUSE endpoint left by an interrupted older process.
if [ "${1:-}" = "configure" ] && [ -n "${2:-}" ]; then
  # Exact argv matching and stable process handles; no numeric-PID escalation.
  /usr/bin/python3 -I -c 'import sys; sys.path.insert(0,"/usr/lib"); from tuxindrive.upgrade_processes import stop_previous_applications; stop_previous_applications()' || true
fi

# Maintainer scripts run without the eventual user's graphical environment.
# Record machine-wide capabilities here; TuxInDrive repeats the check in the
# user's session where GNOME, D-Bus and tray details are visible.
mkdir -p /var/lib/tuxindrive
if [ -x /usr/bin/tuxindrive ]; then
  /usr/bin/tuxindrive --system-check --json > /var/lib/tuxindrive/install-capabilities.json 2>/dev/null || true
  chmod 0644 /var/lib/tuxindrive/install-capabilities.json 2>/dev/null || true
  echo "TuxInDrive installed. Run 'tuxindrive --system-check' in the desktop session for the complete capability report."
fi

# The Debian package name remains `tuxdrive` as a compatibility ABI so the
# signed 0.24.x updater can install this transition. All installed user-facing
# commands, services, icons and desktop metadata use TuxInDrive.

exit 0
